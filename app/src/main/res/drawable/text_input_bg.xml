<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background color with border radius -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" /> <!-- Transparent background -->
            <corners android:radius="8dp" /> <!-- Corner radius -->
            <stroke android:width="1dp" android:color="#D0D5DD" /> <!-- 1px border for all sides -->
        </shape>
    </item>

</layer-list>